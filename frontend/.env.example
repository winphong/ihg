# CRA frontend environment variables (must be prefixed REACT_APP_ to be
# exposed to the browser bundle; CRA reads .env/.env.local at build time).
# Copy to .env.local and fill in real values for local development; set the
# same keys in the Vercel project's Environment Variables for deploys.

# Base URL of the backend API, including the /api prefix.
# e.g. http://localhost:3900/api (local) or https://<deployment>/api (prod)
REACT_APP_API_URL=

# Instagram API endpoint used by the gallery page to fetch photos directly
# from the browser (see src/services/miscService.js).
REACT_APP_INSTAGRAM_API_URL=

# Display text shown in the footer/home page, e.g. "AY25/26".
REACT_APP_ACADEMIC_YEAR=

# Base date (any string `new Date()` can parse) used as "week 0" for the
# schedule page's week-numbering logic (see src/components/calendar.jsx).
REACT_APP_WEEK_0=
