# Go backend (/api) environment variables.
# Copy to .env and fill in real values for local development
# (e.g. `vercel dev` reads this automatically); set the same
# keys in the Vercel project's Environment Variables for deploys.

# MongoDB Atlas connection string. Required - the API will fail to start
# without it. Get this from Atlas > Connect > Drivers (Go), e.g.
# mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/?appName=<appName>
DB_URL=

# Database name to use on the connection above. Optional - defaults to "ihg"
# if unset (matches the original Mongoose setup's default database).
DB_NAME=

# Secret used to sign/verify admin JWTs (HS256). Required in any real
# deployment - if left unset, admin auth is skipped entirely and every
# admin-only route becomes publicly writable (mirrors the original
# server/middleware/admin.js dev-mode escape hatch; do not leave unset in prod).
PRIVATE_KEY=
